      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "LuminaLib-Postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT bb.id as \"ID\", b.title as \"Book Title\", u.email as \"User Email\", to_char(bb.borrowed_at, 'YYYY-MM-DD HH24:MI') as \"Borrowed At\", CASE WHEN bb.returned_at IS NOT NULL THEN to_char(bb.returned_at, 'YYYY-MM-DD HH24:MI') ELSE 'In Progress' END as \"Returned At\", CASE WHEN bb.returned_at IS NOT NULL THEN 'Returned' ELSE 'Active' END as \"Status\" FROM book_borrows bb JOIN books b ON bb.book_id = b.id JOIN users u ON bb.user_id = u.id ORDER BY bb.borrowed_at DESC LIMIT 25;",
          "refId": "A"
        }
      ],
      "title": "\ud83d\udcdc Recent Borrow & Return Activity Audit Trail",
      "type": "table"
